# =====================================================================
# WorkBuddy 每日自动签到 · 环境变量示例
# ---------------------------------------------------------------------
# 本工具「零配置即可运行」（自动探测本机登录态）。
# 仅当你想把数据放在非默认位置、或在其它机器/容器里部署时，才需要改这里。
#
# 用法：复制本文件为 .env（或直接在启动器/系统环境里 export 这些变量）。
#       .env 不会被脚本自动读取，需要你显式注入到运行环境；
#       或在 run-checkin 启动器里自行 source 它。
# =====================================================================

# 可选：显式指定 endpoint.json 路径（不设置则自动从用户主目录探测）。
#       一旦显式指定且文件不存在，脚本会直接报错（exit 2），不会静默回退。
# WBIP_ENDPOINT_FILE=C:\Users\你的用户名\.workbuddy\wbipc\endpoint.json

# 可选：指定 WorkBuddy 主目录（其下应有 wbipc/endpoint.json）。
# WORKBUDDY_HOME=C:\Users\你的用户名\.workbuddy

# 可选：覆盖签到接口路径（一般无需修改）。
# WBIP_CHECKIN_PATH=/v2/billing/meter/daily-checkin

# 可选：连续签到统计的历史记录文件（成长中心功能用，本地文件）。
# WBIP_CHECKIN_HISTORY=C:\Users\你的用户名\.workbuddy\wbipc\checkin-history.json

# 可选：设为 1 可关闭「连续天数统计」（不读取/写入历史文件）。
# WBIP_NO_STATS=0

# 可选：指定日志文件路径。
# WBIP_LOG=C:\Users\你的用户名\.workbuddy\wbipc\checkin.log

# 高级部署：直连模式（同时提供管道名与票据，跳过读取 endpoint.json）。
# WBIP_ENDPOINT=\\.\pipe\wbipc-xxxxxxxx
# WBIP_TICKET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
